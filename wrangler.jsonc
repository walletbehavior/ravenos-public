{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravenos-public",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".deploy-public"
  },
  "routes": [
    {
      "pattern": "ravenos.xyz/*",
      "zone_name": "ravenos.xyz"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
