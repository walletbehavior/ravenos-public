{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravenos-public",
  "main": "worker.mjs",
  "compatibility_date": "2026-06-23",
  "preview_urls": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".deploy-public",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "RAVENOS_CUSTOMER_DB",
      "database_name": "ravenos-customer-security-production",
      "database_id": "3f42c29b-3ab7-453a-8359-4896ed14980b",
      "preview_database_id": "4b8a342d-3e34-4b67-9f0c-7baf5eac0cb3",
      "migrations_dir": "customer-migrations"
    }
  ],
  "routes": [
    {
      "pattern": "ravenos.xyz/*",
      "zone_name": "ravenos.xyz"
    },
    {
      "pattern": "app.ravenos.xyz/*",
      "zone_name": "ravenos.xyz"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ]
}
