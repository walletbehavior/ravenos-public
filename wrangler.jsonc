{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravenos-public",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "ravenos.xyz/*",
      "zone_name": "ravenos.xyz"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.mjs"
}
