{
  "name": "ravenos-rewards-treasury",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"TREASURY_QUOTES_ENABLED": "0", "TREASURY_LIVE_ENABLED": "0"},
  "durable_objects": {"bindings": [{"name": "TREASURY_COORDINATOR", "class_name": "RewardsTreasury"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RewardsTreasury"]}]
}
